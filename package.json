{
  "name": "devianns-clip-maker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node modules/speech-auto-cut/scripts/prepare-assets.mjs && node scripts/dev-plus.mjs",
    "dev:ui": "node modules/speech-auto-cut/scripts/prepare-assets.mjs && vite --host 127.0.0.1",
    "dev:plus": "node modules/speech-auto-cut/scripts/prepare-assets.mjs && node scripts/dev-plus.mjs",
    "server:dev": "node --experimental-strip-types server/index.ts --dev",
    "server:start": "node --experimental-strip-types server/index.ts",
    "server:build": "tsc -p tsconfig.server.json",
    "ai:check": "node --experimental-strip-types scripts/check-ai-connection.ts",
    "password:hash": "node scripts/hash-password.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json",
    "test": "vitest run",
    "checklist:check": "node scripts/check-checklist.mjs",
    "build": "node modules/speech-auto-cut/scripts/prepare-assets.mjs && npm run checklist:check && npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:browser": "node scripts/browser-test.mjs",
    "test:preview": "node scripts/preview-test.mjs",
    "test:v2": "node scripts/v2-browser-test.mjs"
  },
  "dependencies": {
    "mediabunny": "1.66.0",
    "onnxruntime-web": "1.31.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "playwright": "^1.56.0",
    "prettier": "3.10.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  }
}
